FROM registry.access.redhat.com/ubi10/nodejs-24-minimal:1790751316 AS build

# Copy package files
COPY --chown=1001:0 package.json package-lock.json* ./

# Install dependencies
RUN npm ci

# Copy source code
COPY --chown=1001:0 . .

# Build the app
RUN npm run build

# Serve
FROM registry.access.redhat.com/ubi10/nginx-126:1790750866
COPY --from=build /opt/app-root/src/dist /usr/share/nginx/html
EXPOSE 8080
